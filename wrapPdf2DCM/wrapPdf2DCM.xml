          <com.mirth.connect.plugins.javascriptstep.JavaScriptStep version="4.5.2">
            <name>code</name>
            <sequenceNumber>0</sequenceNumber>
            <enabled>true</enabled>
            <script>// Use Packages syntax for importing
var Attributes = Packages.org.dcm4che3.data.Attributes;
var Tag = Packages.org.dcm4che3.data.Tag;
var VR = Packages.org.dcm4che3.data.VR;
var UID = Packages.org.dcm4che3.data.UID;
var DicomOutputStream = Packages.org.dcm4che3.io.DicomOutputStream;
var UIDUtils = Packages.org.dcm4che3.util.UIDUtils;
var ByteArrayOutputStream = Packages.java.io.ByteArrayOutputStream;
var File = Packages.java.io.File;

var dir = sourceMap.get(&apos;fileDirectory&apos;);
var fileNameOrig =  &apos;&apos; + sourceMap.get(&apos;originalFilename&apos;);


var fileNameNoExtension = fileNameOrig.substring(0, fileNameOrig.length - 4);
var fileNamePDF = fileNameNoExtension + &quot;.pdf&quot;;
var fileNameDCM = fileNameNoExtension + &quot;.dcm&quot;;

//logger.info(&apos;Directory of read file: &apos; + dir);
//logger.info(&apos;Original filename: &apos; + fileNameOrig);
//logger.info(&apos;PDF filename: &apos; + fileNamePDF);
//logger.info(&apos;DCM filename: &apos; + fileNameDCM);


// Note! The source PDF needs to be in the same folder and have the same name as the input .txt
var pdfBytes = FileUtil.readBytes(dir + &apos;\\&apos; + fileNamePDF);


// Generate UIDs
var sopInstanceUID = UIDUtils.createUID();
var studyUID = UIDUtils.createUID();
var seriesUID = UIDUtils.createUID();
var currentDate = DateUtil.getCurrentDate(&quot;yyyyMMdd&quot;);
var currentTime = DateUtil.getCurrentDate(&quot;HHmmss&quot;);

// Create DICOM attributes - MAIN DATASET
var attrs = new Attributes();

// SOP Class and Instance
attrs.setString(Tag.SOPClassUID, VR.UI, UID.EncapsulatedPDFStorage);
attrs.setString(Tag.SOPInstanceUID, VR.UI, sopInstanceUID);

var patientId= msg[&apos;row&apos;][&apos;column1&apos;].toString();
var patientName = msg[&apos;row&apos;][&apos;column2&apos;].toString();
var studyDescription = fileNameNoExtension;

// Patient Information
attrs.setString(Tag.PatientID, VR.LO, patientId);
attrs.setString(Tag.PatientName, VR.PN, patientName);
//attrs.setString(Tag.PatientBirthDate, VR.DA, &quot;19700101&quot;);
//attrs.setString(Tag.PatientSex, VR.CS, &quot;O&quot;);

// Study Information
attrs.setString(Tag.StudyInstanceUID, VR.UI, studyUID);
attrs.setString(Tag.StudyDate, VR.DA, currentDate);
attrs.setString(Tag.StudyTime, VR.TM, currentTime);
attrs.setString(Tag.StudyDescription, VR.LO, studyDescription);
attrs.setString(Tag.StudyID, VR.SH, &quot;1&quot;);

// Series Information
attrs.setString(Tag.SeriesInstanceUID, VR.UI, seriesUID);
attrs.setString(Tag.SeriesNumber, VR.IS, &quot;1&quot;);
attrs.setString(Tag.SeriesDescription, VR.LO, &quot;PDF Document Series&quot;);
attrs.setString(Tag.Modality, VR.CS, &quot;OT&quot;);

// Instance Information
attrs.setString(Tag.InstanceNumber, VR.IS, &quot;1&quot;);
attrs.setString(Tag.ContentDate, VR.DA, currentDate);
attrs.setString(Tag.ContentTime, VR.TM, currentTime);

// Document Information  
attrs.setString(Tag.DocumentTitle, VR.ST, &quot;Encapsulated PDF Document&quot;);
attrs.setString(Tag.MIMETypeOfEncapsulatedDocument, VR.LO, &quot;application/pdf&quot;);

// Encapsulated Document
attrs.setBytes(Tag.EncapsulatedDocument, VR.OB, pdfBytes);


// write to file
var outputDcmPath = dir + &apos;\\&apos; + fileNameDCM;

var dos = new DicomOutputStream(new File(outputDcmPath));
dos.writeDataset(null, attrs);
dos.close();</script>
          </com.mirth.connect.plugins.javascriptstep.JavaScriptStep>
